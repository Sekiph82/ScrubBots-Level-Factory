# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Packaging, build and coverage output
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Generated candidate output: keep only the directory marker.
output/*
!output/.gitkeep

# Godot-facing generated/export staging: keep only the directory marker.
level_factory/output/*
!level_factory/output/.gitkeep

# Owner-local artwork catalog and Release Pool records are runtime data.
# Keep source code/tests visible; only these explicit data roots are ignored.
data/input/*.csv
data/output/Alpix/**
!data/output/Alpix/.gitkeep
data/output/Pixellab/Grid Files/**
!data/output/Pixellab/Grid Files/.gitkeep
data/output/Pixellab/Final/**
!data/output/Pixellab/Final/.gitkeep
data/output/Pixellab/atlas-*.json
data/output/Owner Suggestions/**
!data/output/Owner Suggestions/.gitkeep
data/Release Pool/**
!data/Release Pool/.gitkeep

# Runtime logs and temporary WFC/cache material
logs/
*.log
.wfc-cache/
wfc-cache/
tmp/
temp/

# Godot editor/import cache for the independent Level Factory project
level_factory/.godot/

# Local-only secret locations; a root .env.example template remains allowed.
.env
.env.*
!.env.example
.secrets/
secrets/
level_factory/.secrets/
level_factory/secrets/
