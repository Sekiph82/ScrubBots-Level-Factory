# Python environments and caches
.venv/
venv/
.buildvenv/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Packaging, build and coverage output
build/
dist/
app_build/
app_dist/
setup_build/
setup_dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Generated candidate output: keep only the directory marker.
output/*
!output/.gitkeep

# Content-platform generated/runtime state
content/candidates/
content/rejected/
content/tmp/
publishing/local/
publishing/staging-cache/
publishing/production-cache/
.scrubpack-cache/

# Factory Studio local state / release artifacts
studio/.venv/
studio/.buildvenv/
studio/build/
studio/dist/
studio/app_build/
studio/app_dist/
studio/setup_build/
studio/setup_dist/
studio/*.db
studio/*.sqlite
studio/*.sqlite3
studio/local_state/
studio/credentials/
studio/release/*.exe

# Secrets / credentials / local env
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/

# Runtime logs and temporary WFC/cache material
logs/
*.log
.wfc-cache/
wfc-cache/
tmp/
temp/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
