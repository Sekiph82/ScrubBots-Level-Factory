{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrubbots.invalid/content-pipeline/schemas/v1/secret-reference.schema.json",
  "title": "SCRUBBOTS Content Pipeline Secret Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["reference_version", "reference_id", "purpose", "environment", "version_label"],
  "properties": {
    "reference_version": { "const": "1.0" },
    "reference_id": { "type": "string", "pattern": "^ref-[A-Za-z0-9][A-Za-z0-9._-]{0,91}$" },
    "purpose": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
    "environment": { "enum": ["staging", "production"] },
    "version_label": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" }
  }
}
