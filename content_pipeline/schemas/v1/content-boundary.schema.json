{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrubbots.invalid/content-pipeline/schemas/v1/content-boundary.schema.json",
  "title": "SCRUBBOTS Remote Content Boundary Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "boundary_version",
    "content_type",
    "logical_path",
    "media_type",
    "descriptor_contract_id",
    "payload_contract",
    "attributes"
  ],
  "properties": {
    "boundary_version": {
      "const": "1.0"
    },
    "content_type": {
      "enum": ["level_data", "supply_plan_data", "approved_metadata"]
    },
    "logical_path": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "media_type": {
      "enum": [
        "application/vnd.scrubbots.level+json",
        "application/vnd.scrubbots.supply-plan+json",
        "application/vnd.scrubbots.approved-metadata+json"
      ]
    },
    "descriptor_contract_id": {
      "enum": [
        "scrubbots.content-pipeline.level-data.v1",
        "scrubbots.content-pipeline.supply-plan.v1",
        "scrubbots.content-pipeline.publisher-metadata.v1"
      ]
    },
    "payload_contract": { "type": "object" },
    "attributes": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "content_type": { "const": "level_data" },
        "media_type": { "const": "application/vnd.scrubbots.level+json" },
        "descriptor_contract_id": {
          "const": "scrubbots.content-pipeline.level-data.v1"
        },
        "payload_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "version"],
          "properties": {
            "authority": { "const": "Level Data Specification" },
            "version": { "const": 1 }
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level_id", "payload_sha256", "width", "height"],
          "properties": {
            "level_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
            "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "width": { "type": "integer", "minimum": 1, "maximum": 256 },
            "height": { "type": "integer", "minimum": 1, "maximum": 256 }
          }
        }
      }
    },
    {
      "properties": {
        "content_type": { "const": "supply_plan_data" },
        "media_type": { "const": "application/vnd.scrubbots.supply-plan+json" },
        "descriptor_contract_id": {
          "const": "scrubbots.content-pipeline.supply-plan.v1"
        },
        "payload_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "version"],
          "properties": {
            "schema": { "const": "scrubbots.level_supply_plan.v1" },
            "version": { "const": 1 }
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level_id", "supply_plan_sha256", "columns", "preview_depth"],
          "properties": {
            "level_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
            "supply_plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "columns": { "enum": [3, 4, 5] },
            "preview_depth": { "const": 3 }
          }
        }
      }
    },
    {
      "properties": {
        "content_type": { "const": "approved_metadata" },
        "media_type": { "const": "application/vnd.scrubbots.approved-metadata+json" },
        "descriptor_contract_id": {
          "const": "scrubbots.content-pipeline.publisher-metadata.v1"
        },
        "payload_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "version"],
          "properties": {
            "schema": { "const": "scrubbots.level.metadata.v1" },
            "version": { "const": 1 }
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level_id",
            "payload_sha256",
            "width",
            "height",
            "columns",
            "preview_depth"
          ],
          "properties": {
            "level_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
            "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "width": { "type": "integer", "minimum": 1, "maximum": 256 },
            "height": { "type": "integer", "minimum": 1, "maximum": 256 },
            "columns": { "enum": [3, 4, 5] },
            "preview_depth": { "const": 3 }
          }
        }
      }
    }
  ]
}
