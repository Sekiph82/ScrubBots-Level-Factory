{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrubbots.invalid/content-pipeline/schemas/v1/content-boundary.schema.json",
  "title": "SCRUBBOTS Remote Content Boundary Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "boundary_version",
    "content_type",
    "logical_path",
    "media_type",
    "schema_id",
    "attributes"
  ],
  "properties": {
    "boundary_version": {
      "const": "1.0"
    },
    "content_type": {
      "enum": ["level_data", "supply_plan_data", "approved_metadata"]
    },
    "logical_path": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "media_type": {
      "enum": [
        "application/vnd.scrubbots.level+json",
        "application/vnd.scrubbots.supply-plan+json",
        "application/vnd.scrubbots.approved-metadata+json"
      ]
    },
    "schema_id": {
      "enum": [
        "scrubbots.level.v1",
        "scrubbots.supply-plan.v1",
        "scrubbots.approved-metadata.v1"
      ]
    },
    "attributes": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "content_type": { "const": "level_data" },
        "media_type": { "const": "application/vnd.scrubbots.level+json" },
        "schema_id": { "const": "scrubbots.level.v1" },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level_id", "payload_sha256", "width", "height"],
          "properties": {
            "level_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
            "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "width": { "type": "integer", "minimum": 1, "maximum": 256 },
            "height": { "type": "integer", "minimum": 1, "maximum": 256 }
          }
        }
      }
    },
    {
      "properties": {
        "content_type": { "const": "supply_plan_data" },
        "media_type": { "const": "application/vnd.scrubbots.supply-plan+json" },
        "schema_id": { "const": "scrubbots.supply-plan.v1" },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level_id", "supply_plan_sha256", "columns", "preview_depth"],
          "properties": {
            "level_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
            "supply_plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "columns": { "enum": [3, 4, 5] },
            "preview_depth": { "const": 3 }
          }
        }
      }
    },
    {
      "properties": {
        "content_type": { "const": "approved_metadata" },
        "media_type": { "const": "application/vnd.scrubbots.approved-metadata+json" },
        "schema_id": { "const": "scrubbots.approved-metadata.v1" },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level_id", "locale", "display_name"],
          "properties": {
            "level_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
            "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
            "display_name": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        }
      }
    }
  ]
}
