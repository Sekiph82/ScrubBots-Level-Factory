{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrubbots.invalid/content-pipeline/schemas/v1/pipeline-config.schema.json",
  "title": "SCRUBBOTS Content Pipeline Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "input_contract",
    "require_owner_approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "environment": {
      "enum": ["staging", "production"]
    },
    "input_contract": {
      "type": "string",
      "minLength": 1
    },
    "require_owner_approval": {
      "type": "boolean",
      "const": true
    }
  }
}
