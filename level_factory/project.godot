; Engine configuration file.
; This file is intentionally minimal: level_factory is an independently openable Godot project.

config_version=5

[application]

config/name="ScrubBots Factory Studio"
config/icon="res://assets/icons/ScrubBots_Factory_Studio_256.png"
config/windows_native_icon="res://assets/icons/ScrubBots_Factory_Studio.ico"
boot_splash/image="res://assets/icons/ScrubBots_Factory_Studio_256.png"
boot_splash/bg_color=Color(0.0431373, 0.0705882, 0.12549, 1)
boot_splash/fullsize=false
boot_splash/show_image=true
boot_splash/use_filter=true
run/main_scene="res://scenes/factory_studio.tscn"

[display]

window/size/viewport_width=1536
window/size/viewport_height=1024
window/size/window_width_override=1536
window/size/window_height_override=1024
window/size/window_width_override_margin=32

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
