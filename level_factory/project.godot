; Engine configuration file.
; This file is intentionally minimal: level_factory is an independently openable Godot project.

config_version=5

[application]

config/name="ScrubBots Factory Studio"
config/icon="res://assets/icons/ScrubBots_Factory_Studio_256.png"
config/windows_native_icon="res://assets/icons/ScrubBots_Factory_Studio.ico"
run/main_scene="res://scenes/factory_studio.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
